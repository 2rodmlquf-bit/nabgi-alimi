# 의존성과 빌드 결과 (설치 파일은 111MB라 저장소에 넣지 않는다)
node_modules/
dist/

# 임시·백업 파일
*.tmp
*.bak
*.corrupt-*.json

# E2E 결과물 (스크린샷, 임시 데이터)
e2e/out/
.e2e-userdata*/

# 운영체제·편집기
Thumbs.db
.DS_Store

# 실제 사용자 데이터의 백업 (저장소에 넣지 않는다)
.backup/

# Supabase QA: 프로젝트 주소·키·시험 계정은 저장소에 올리지 않는다
supabase/qa/*.local.*
supabase/qa/.env*
